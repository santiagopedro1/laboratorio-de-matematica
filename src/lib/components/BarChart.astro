---
interface Props {
	csvPath: string;
	xColumn: string;
	yColumns: string[];
	title: string;
	subtitle?: string;
}

const { csvPath, xColumn, yColumns, title, subtitle } = Astro.props;
---

<canvas
	class="chart"
	data-csv={csvPath}
	data-x={xColumn}
	data-y={JSON.stringify(yColumns)}
	data-title={title}
	data-subtitle={subtitle || ''}
></canvas>

<script>
	import { initChart } from './chartUtils';

	// Run on initial load
	initChart('bar');

	// Run on subsequent navigations if using View Transitions
	document.addEventListener('astro:page-load', () => initChart('bar'));
</script>
